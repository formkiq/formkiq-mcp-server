# Copy to .env and fill in your deployment's HttpApiUrl and raw Cognito AccessToken.
# Existing environment variables take precedence. Restart after editing this file.
FORMKIQ_API_ENDPOINT_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
FORMKIQ_JWT=

# Use streamable-http for MCP Inspector; stdio for clients that launch the server.
MCP_TRANSPORT=streamable-http
FORMKIQ_MCP_HOST=127.0.0.1
FORMKIQ_MCP_PORT=8000

# Available groups: core, ocr, fulltext, ai, malware, workflows, audit.
FORMKIQ_API_GROUPS=core
# Discover installed modules automatically before serving the initial tool list.
FORMKIQ_AUTO_DISCOVER=true
# Declare installed capabilities not advertised by get_version, when needed.
FORMKIQ_MODULES=

# Writes and permanent purge require explicit enablement.
FORMKIQ_ENABLE_WRITES=false
FORMKIQ_ENABLE_PURGE=false
